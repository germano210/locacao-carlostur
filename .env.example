# Copiar para .env (o .env fica fora do Git). Este app não tem chaves secretas.
CT_HTTPS=1
# Endereços de onde o painel pode salvar (inclua o subdomínio de teste enquanto ele existir)
CT_ORIGENS=https://carlostur.com.br,https://www.carlostur.com.br,https://teste.carlostur.com.br
# Mude a data quando o termo do painel mudar: todos aceitam de novo na próxima entrada
CT_ACEITE_VERSAO=2026-11-11
# Backup (backup.sh): chave PÚBLICA do age (age-keygen gera o par; a chave privada fica fora do servidor)
CT_BACKUP_CHAVE=
CT_BACKUP_DESTINO=/mnt/backup/carlostur
